# Optional. If set, the assistant uses this free Groq API key (open-source
# Llama models) to compose answers from retrieved PDF passages.
# Get a free key at https://console.groq.com — leave unset to use
# extractive (no-LLM) retrieval answers instead.
GROQ_API_KEY=

# Application
NODE_ENV=development
PORT=3000
APP_NAME=VIT AI Core

# API
VITE_API_URL=http://localhost:3000/api
API_TIMEOUT=30000

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=

# AI
GROQ_API_KEY=
OPENAI_API_KEY=

# Logging
LOG_LEVEL=info

# Features
ENABLE_ANALYTICS=false
ENABLE_DEBUG=false
